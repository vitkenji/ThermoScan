# PostgreSQL configuration
POSTGRES_USER=termoscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=termoscan
POSTGRES_PORT=5432

# Backend API configuration
DATABASE_URL=postgres://termoscan:change-me@localhost:5432/termoscan?sslmode=disable
API_PORT=8080
JWT_SECRET=replace-with-high-entropy-secret

# Initial System Admin bootstrap (only used when no system_admin exists in DB)
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
